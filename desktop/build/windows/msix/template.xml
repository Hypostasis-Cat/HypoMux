<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="hypomux.exe"
        Arguments=""
        InstallLocation="C:\Program Files\HypoMux\HypoMux">
    </Installer>
    <PackageInformation
        PackageName="HypoMux"
        PackageDisplayName="HypoMux"
        PublisherName="CN=HypoMux"
        PublisherDisplayName="HypoMux"
        Version="2.1.0.0"
        PackageDescription="Multi-link network aggregation desktop client">
        <Capabilities>
            <Capability Name="runFullTrust" />

        </Capabilities>
        <Applications>
            <Application
                Id="io.hypomux.desktop"
                Description="Multi-link network aggregation desktop client"
                DisplayName="HypoMux"
                ExecutableName="hypomux.exe"
                EntryPoint="Windows.FullTrustApplication">

            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>HypoMux</DisplayName>
            <PublisherDisplayName>HypoMux</PublisherDisplayName>
            <Description>Multi-link network aggregation desktop client</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="hypomux.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
