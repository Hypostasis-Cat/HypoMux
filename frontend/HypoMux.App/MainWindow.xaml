<ui:FluentWindow
    x:Class="HypoMux.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="HypoMux"
    Width="1080"
    Height="720"
    MinWidth="900"
    MinHeight="600"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Title="HypoMux" />

        <Grid
            Grid.Row="1"
            Margin="20,12,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ui:Card Margin="0,0,0,12">
                <Grid Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="{DynamicResource EngineConnection}" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Text="{Binding ConnectionState}" />
                        <TextBlock
                            Margin="24,0,0,0"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="{DynamicResource EngineVersion}" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Text="{Binding EngineVersion}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal">
                        <ui:Button
                            Margin="0,0,8,0"
                            Command="{Binding ReconnectCommand}"
                            Content="{DynamicResource Reconnect}" />
                        <ui:Button
                            Command="{Binding RefreshCommand}"
                            Content="{DynamicResource Refresh}" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <TabControl
                Grid.Row="1"
                TabStripPlacement="Left">
                <TabItem Header="{DynamicResource NavOverview}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="20,8,8,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ui:Card Margin="0,0,0,12">
                                <Grid Margin="18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="18"
                                            FontWeight="SemiBold"
                                            Text="{DynamicResource AccelerationControl}" />
                                        <WrapPanel Margin="0,12,0,0">
                                            <CheckBox
                                                Margin="0,0,24,0"
                                                Content="{DynamicResource TunMode}"
                                                IsChecked="{Binding UseTunMode}" />
                                            <CheckBox
                                                Margin="0,0,24,0"
                                                Content="{DynamicResource WeightedMode}"
                                                IsChecked="{Binding Weighted}" />
                                            <CheckBox
                                                Margin="0,0,24,0"
                                                Content="{DynamicResource StrictRoute}"
                                                IsChecked="{Binding StrictRoute}" />
                                            <TextBlock
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Text="SOCKS" />
                                            <TextBox
                                                Width="70"
                                                Margin="0,0,16,0"
                                                Text="{Binding SocksPort, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Text="HTTP" />
                                            <TextBox
                                                Width="70"
                                                Text="{Binding HttpPort, UpdateSourceTrigger=PropertyChanged}" />
                                        </WrapPanel>
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <ui:Button
                                            Margin="0,0,8,0"
                                            Appearance="Primary"
                                            Command="{Binding StartCommand}"
                                            Content="{DynamicResource StartAcceleration}" />
                                        <ui:Button
                                            Command="{Binding StopCommand}"
                                            Content="{DynamicResource StopAcceleration}" />
                                    </StackPanel>
                                </Grid>
                            </ui:Card>
                            <UniformGrid Grid.Row="1" Columns="2">
                                <ui:Card Margin="0,0,8,8">
                                    <StackPanel Margin="18">
                                        <TextBlock
                                            FontSize="14"
                                            Text="{DynamicResource EngineState}" />
                                        <TextBlock
                                            Margin="0,8,0,0"
                                            FontSize="28"
                                            FontWeight="SemiBold"
                                            Text="{Binding EngineState}" />
                                    </StackPanel>
                                </ui:Card>
                                <ui:Card Margin="0,0,0,8">
                                    <StackPanel Margin="18">
                                        <TextBlock
                                            FontSize="14"
                                            Text="{DynamicResource TunState}" />
                                        <TextBlock
                                            Margin="0,8,0,0"
                                            FontSize="28"
                                            FontWeight="SemiBold"
                                            Text="{Binding TunState}" />
                                    </StackPanel>
                                </ui:Card>
                                <ui:Card Margin="0,0,8,8">
                                    <StackPanel Margin="18">
                                        <TextBlock Text="{DynamicResource Health}" />
                                        <TextBlock
                                            Margin="0,8,0,0"
                                            FontSize="18"
                                            Text="{Binding HealthSummary}" />
                                    </StackPanel>
                                </ui:Card>
                                <ui:Card Margin="0,0,0,8">
                                    <StackPanel Margin="18">
                                        <TextBlock Text="{DynamicResource Platform}" />
                                        <TextBlock
                                            Margin="0,8,0,0"
                                            FontSize="18"
                                            Text="{Binding Platform}" />
                                        <TextBlock
                                            Margin="0,4,0,0"
                                            Text="{Binding Elevation}" />
                                    </StackPanel>
                                </ui:Card>
                            </UniformGrid>
                            <StackPanel
                                Grid.Row="2"
                                Margin="4,12,0,0"
                                Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource LastRefresh}" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    Text="{Binding LastRefresh}" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{DynamicResource NavAdapters}">
                    <Grid Margin="20,8,8,8">
                        <DataGrid
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            ItemsSource="{Binding Adapters}">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn
                                    Width="70"
                                    Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                    Header="{DynamicResource Selected}" />
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding Name}"
                                    IsReadOnly="True"
                                    Header="{DynamicResource AdapterName}" />
                                <DataGridTextColumn
                                    Width="140"
                                    Binding="{Binding SourceIp}"
                                    IsReadOnly="True"
                                    Header="IPv4" />
                                <DataGridTextColumn
                                    Width="80"
                                    Binding="{Binding IfIndex}"
                                    IsReadOnly="True"
                                    Header="IfIndex" />
                                <DataGridTextColumn
                                    Width="100"
                                    Binding="{Binding HealthState}"
                                    IsReadOnly="True"
                                    Header="{DynamicResource AdapterHealth}" />
                                <DataGridTextColumn
                                    Width="100"
                                    Binding="{Binding Connections}"
                                    IsReadOnly="True"
                                    Header="{DynamicResource Connections}" />
                                <DataGridTextColumn
                                    Width="120"
                                    Binding="{Binding BytesDown}"
                                    IsReadOnly="True"
                                    Header="{DynamicResource DownloadBytes}" />
                                <DataGridTextColumn
                                    Width="120"
                                    Binding="{Binding BytesUp}"
                                    IsReadOnly="True"
                                    Header="{DynamicResource UploadBytes}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="{DynamicResource NavRouting}">
                    <Grid Margin="20,8,8,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ui:Card Margin="0,0,0,12">
                            <WrapPanel Margin="16">
                                <ComboBox
                                    Width="130"
                                    Margin="0,0,8,0"
                                    SelectedValue="{Binding NewRuleMatchType}"
                                    SelectedValuePath="Content">
                                    <ComboBoxItem Content="process" />
                                    <ComboBoxItem Content="domain" />
                                    <ComboBoxItem Content="ip_cidr" />
                                </ComboBox>
                                <TextBox
                                    Width="280"
                                    Margin="0,0,8,0"
                                    Text="{Binding NewRuleValue, UpdateSourceTrigger=PropertyChanged}" />
                                <ComboBox
                                    Width="150"
                                    Margin="0,0,8,0"
                                    SelectedValue="{Binding NewRuleOutbound}"
                                    SelectedValuePath="Content">
                                    <ComboBoxItem Content="direct" />
                                    <ComboBoxItem Content="aggregation" />
                                    <ComboBoxItem Content="nic_ethernet" />
                                    <ComboBoxItem Content="nic_wifi" />
                                </ComboBox>
                                <ui:Button
                                    Margin="0,0,8,0"
                                    Command="{Binding AddRoutingRuleCommand}"
                                    Content="{DynamicResource AddRule}" />
                                <ui:Button
                                    Command="{Binding RemoveRoutingRuleCommand}"
                                    Content="{DynamicResource RemoveRule}" />
                            </WrapPanel>
                        </ui:Card>
                        <DataGrid
                            Grid.Row="1"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            ItemsSource="{Binding RoutingRules}"
                            SelectedItem="{Binding SelectedRoutingRule}">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="140"
                                    Binding="{Binding MatchType}"
                                    Header="{DynamicResource MatchType}" />
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding Value}"
                                    Header="{DynamicResource MatchValue}" />
                                <DataGridTextColumn
                                    Width="180"
                                    Binding="{Binding Outbound}"
                                    Header="{DynamicResource Outbound}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="{DynamicResource NavDiagnostics}">
                    <Grid Margin="20,8,8,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="260" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="{DynamicResource SourceIp}" />
                            <TextBox
                                Grid.Column="1"
                                Text="{Binding DiagnosticSourceIp, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                Text="{DynamicResource TargetIp}" />
                            <TextBox
                                Grid.Column="4"
                                Text="{Binding DiagnosticTargetIp, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <StackPanel
                            Grid.Row="1"
                            Margin="0,16,0,16"
                            Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Text="{DynamicResource ProbeCount}" />
                            <TextBox
                                Width="80"
                                Margin="0,0,12,0"
                                Text="{Binding DiagnosticCount, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button
                                Command="{Binding RunDiagnosticCommand}"
                                Content="{DynamicResource RunDiagnostic}" />
                        </StackPanel>
                        <ui:Card Grid.Row="2">
                            <TextBlock
                                Margin="18"
                                FontFamily="Consolas"
                                Text="{Binding DiagnosticResult}"
                                TextWrapping="Wrap" />
                        </ui:Card>
                    </Grid>
                </TabItem>

                <TabItem Header="{DynamicResource NavLogs}">
                    <Grid Margin="20,8,8,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel
                            Margin="0,0,0,8"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <ui:Button
                                Command="{Binding ClearLogsCommand}"
                                Content="{DynamicResource ClearLogs}" />
                        </StackPanel>
                        <ListBox
                            Grid.Row="1"
                            FontFamily="Consolas"
                            ItemsSource="{Binding Logs}" />
                    </Grid>
                </TabItem>

                <TabItem Header="{DynamicResource NavAppearance}">
                    <StackPanel Margin="20,8,8,8">
                        <TextBlock
                            Margin="0,0,0,12"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="{DynamicResource Theme}" />
                        <WrapPanel>
                            <ui:Button
                                Margin="0,0,8,0"
                                Click="OnSystemThemeClick"
                                Content="{DynamicResource ThemeSystem}" />
                            <ui:Button
                                Margin="0,0,8,0"
                                Click="OnLightThemeClick"
                                Content="{DynamicResource ThemeLight}" />
                            <ui:Button
                                Click="OnDarkThemeClick"
                                Content="{DynamicResource ThemeDark}" />
                        </WrapPanel>
                        <CheckBox
                            Margin="0,24,0,0"
                            Content="{DynamicResource CloseToTray}"
                            IsChecked="{Binding CloseToTray}" />
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</ui:FluentWindow>
