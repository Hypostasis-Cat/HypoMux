<ui:FluentWindow
    x:Class="HypoMux.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="HypoMux"
    Width="1120"
    Height="800"
    MinWidth="980"
    MinHeight="680"
    Background="{StaticResource AppBackgroundBrush}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <ui:FluentWindow.Resources>
        <Style x:Key="SegmentRadioStyle" TargetType="RadioButton">
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="Height" Value="31" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#D7DDE5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border
                                x:Name="Surface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                                <ContentPresenter
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                            <Border
                                x:Name="Underline"
                                Width="16"
                                Height="3"
                                Margin="0,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Background="{StaticResource PrimaryBrush}"
                                CornerRadius="2"
                                Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#F3F6F9" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#FFFFFF" />
                                <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingRowStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>

        <Style x:Key="SmallGlyphStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Width" Value="32" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Title="HypoMux" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Background="#F5F8FC"
                BorderBrush="#E1E7EF"
                BorderThickness="0,0,1,0">
                <StackPanel Margin="0,2,0,0">
                    <RadioButton
                        Content="&#xE80F;"
                        GroupName="Navigation"
                        IsChecked="True"
                        Style="{StaticResource NavButtonStyle}"
                        Tag="0"
                        ToolTip="聚合引擎"
                        Click="OnNavigateClick" />
                    <RadioButton
                        Content="&#xE774;"
                        GroupName="Navigation"
                        Style="{StaticResource NavButtonStyle}"
                        Tag="1"
                        ToolTip="高级分流规则"
                        Click="OnNavigateClick" />
                    <RadioButton
                        Content="&#xE9D2;"
                        GroupName="Navigation"
                        Style="{StaticResource NavButtonStyle}"
                        Tag="2"
                        ToolTip="网卡链路体检"
                        Click="OnNavigateClick" />
                    <RadioButton
                        Content="&#xE713;"
                        GroupName="Navigation"
                        Style="{StaticResource NavButtonStyle}"
                        Tag="3"
                        ToolTip="系统设置"
                        Click="OnNavigateClick" />
                    <RadioButton
                        Content="&#xE946;"
                        GroupName="Navigation"
                        Style="{StaticResource NavButtonStyle}"
                        Tag="4"
                        ToolTip="关于"
                        Click="OnNavigateClick" />
                </StackPanel>
            </Border>

            <TabControl
                x:Name="MainTabs"
                Grid.Column="1"
                Background="Transparent"
                BorderThickness="0"
                SelectedIndex="0">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent" />
                    </ControlTemplate>
                </TabControl.Template>

                <!-- 首页 -->
                <TabItem>
                    <Grid Margin="16,12,24,22">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="236" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="74" />
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="285" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.ColumnSpan="2"
                                    FontSize="20"
                                    FontWeight="Bold"
                                    Text="聚合分流引擎" />

                                <StackPanel
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Margin="0,10,0,0"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource MutedTextBrush}"
                                        Text="运行模式" />
                                    <RadioButton
                                        x:Name="ProxyModeButton"
                                        Content="系统代理模式"
                                        GroupName="EngineMode"
                                        IsChecked="True"
                                        Style="{StaticResource SegmentRadioStyle}"
                                        Checked="OnProxyModeChecked" />
                                    <RadioButton
                                        x:Name="TunModeButton"
                                        Margin="-1,0,0,0"
                                        Content="虚拟网卡模式"
                                        GroupName="EngineMode"
                                        Style="{StaticResource SegmentRadioStyle}"
                                        Checked="OnTunModeChecked" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Margin="2,12,0,0">
                                    <CheckBox
                                        Margin="0,0,0,8"
                                        Click="OnAccelerationToggleClick"
                                        Content="启用聚合引擎"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        IsChecked="{Binding IsAccelerating, Mode=OneWay}" />
                                    <TextBlock
                                        Margin="25,-6,0,10"
                                        Style="{StaticResource CaptionStyle}"
                                        Text="启动后将使用已勾选网卡进行聚合分流。" />
                                    <CheckBox
                                        Content="使用权重调度器"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        IsChecked="{Binding Weighted}" />
                                    <TextBlock
                                        Margin="25,2,0,11"
                                        Style="{StaticResource CaptionStyle}"
                                        Text="按网卡相对权重分配新连接；关闭后采用轮询均分。" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button
                                            Margin="0,0,8,0"
                                            Command="{Binding StartCommand}"
                                            Content="启动聚合"
                                            Style="{StaticResource PrimaryButtonStyle}" />
                                        <Button
                                            Command="{Binding StopCommand}"
                                            Content="停止"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                        <TextBlock
                                            Margin="14,0,0,0"
                                            VerticalAlignment="Center"
                                            Foreground="{StaticResource MutedTextBrush}">
                                            <Run Text="SOCKS " />
                                            <Run Text="{Binding SocksPort, Mode=OneWay}" />
                                            <Run Text=" · HTTP/HTTPS " />
                                            <Run Text="{Binding HttpPort, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Margin="16,6,0,0"
                                    HorizontalAlignment="Right">
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        FontSize="47"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource PrimaryBrush}"
                                        Text="{Binding DownloadRateText}" />
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        Foreground="{StaticResource MutedTextBrush}"
                                        Text="合并下行总速度" />
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Right"
                                        Foreground="{StaticResource MutedTextBrush}">
                                        <Run Text="上行 " />
                                        <Run Text="{Binding UploadRateText, Mode=OneWay}" />
                                        <Run Text=" · 总连接 " />
                                        <Run Text="{Binding TotalConnections, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock
                                        Margin="0,12,0,0"
                                        HorizontalAlignment="Right"
                                        Text="{Binding ConnectionState}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border
                            Grid.Row="2"
                            Padding="18,14"
                            Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="42" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SectionTitleStyle}"
                                        Text="网卡链路遥测" />
                                    <StackPanel
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal">
                                        <Button
                                            Margin="0,0,8,0"
                                            Command="{Binding SelectAllAdaptersCommand}"
                                            Content="全选"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button
                                            Margin="0,0,8,0"
                                            Command="{Binding ClearAdapterSelectionCommand}"
                                            Content="取消全选"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button
                                            Command="{Binding RescanAdaptersCommand}"
                                            Content="刷新"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                                <DataGrid
                                    Grid.Row="1"
                                    ItemsSource="{Binding Adapters}"
                                    SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn
                                            Width="58"
                                            Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                            Header="选择" />
                                        <DataGridTextColumn
                                            Width="1.25*"
                                            Binding="{Binding Name}"
                                            Header="网卡" />
                                        <DataGridTextColumn
                                            Width="120"
                                            Binding="{Binding SourceIp}"
                                            Header="IPv4" />
                                        <DataGridTextColumn
                                            Width="1.2*"
                                            Binding="{Binding TrafficSummary}"
                                            Header="实时流量" />
                                        <DataGridTextColumn
                                            Width="90"
                                            Binding="{Binding Connections}"
                                            Header="连接" />
                                        <DataGridTextColumn
                                            Width="90"
                                            Binding="{Binding Weight, UpdateSourceTrigger=PropertyChanged}"
                                            Header="调度权重" />
                                        <DataGridTextColumn
                                            Width="90"
                                            Binding="{Binding HealthState}"
                                            Header="状态" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <UniformGrid Grid.Row="4" Columns="4">
                            <Border Margin="0,0,8,0" Style="{StaticResource MetricCardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="活动连接数" />
                                    <TextBlock Margin="0,7,0,0" FontWeight="SemiBold" Text="{Binding TotalConnections, StringFormat={}{0} 个活动链路}" />
                                </StackPanel>
                            </Border>
                            <Border Margin="0,0,8,0" Style="{StaticResource MetricCardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="本期已加速" />
                                    <TextBlock Margin="0,7,0,0" FontWeight="SemiBold" Text="{Binding SessionDataText}" />
                                </StackPanel>
                            </Border>
                            <Border Margin="0,0,8,0" Style="{StaticResource MetricCardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="节点抖动" />
                                    <TextBlock Margin="0,7,0,0" FontWeight="SemiBold" Text="{Binding JitterText}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricCardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="加速内核" />
                                    <TextBlock Margin="0,7,0,0" FontWeight="SemiBold" Text="{Binding EngineState}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </Grid>
                </TabItem>

                <!-- 分流规则 -->
                <TabItem>
                    <Grid Margin="16,24,24,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="62" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource PageTitleStyle}" Text="高级分流规则" />
                        <TextBlock
                            Grid.Row="1"
                            Margin="0,8,0,16"
                            Foreground="{StaticResource MutedTextBrush}"
                            Text="可按进程、域名（含子域名）或目标 IP/CIDR 指派出口。未命中规则的流量默认走聚合通道。" />

                        <Border Grid.Row="2" Padding="12,8" Style="{StaticResource CardStyle}">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        Margin="0,0,8,0"
                                        Click="OnAddRuleClick"
                                        Content="＋ 添加规则"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                                    <Button
                                        Command="{Binding RemoveRoutingRuleCommand}"
                                        Content="删除选中"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <Button
                                        Margin="0,0,8,0"
                                        Click="OnExportRulesClick"
                                        Content="导出规则"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button
                                        Click="OnImportRulesClick"
                                        Content="导入规则"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="3" Margin="0,18,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="42" />
                                <RowDefinition Height="51" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="规则列表" />
                                    <TextBlock
                                        Margin="10,6,0,0"
                                        Foreground="{StaticResource MutedTextBrush}"
                                        Text="{Binding RoutingRules.Count, StringFormat={}{0} 条}" />
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <RadioButton
                                        Content="进程规则"
                                        GroupName="RuleFilter"
                                        IsChecked="True"
                                        Style="{StaticResource SegmentRadioStyle}"
                                        Tag="process"
                                        Click="OnRuleFilterClick" />
                                    <RadioButton
                                        Margin="-1,0,0,0"
                                        Content="域名规则"
                                        GroupName="RuleFilter"
                                        Style="{StaticResource SegmentRadioStyle}"
                                        Tag="domain"
                                        Click="OnRuleFilterClick" />
                                    <RadioButton
                                        Margin="-1,0,0,0"
                                        Content="IP 规则"
                                        GroupName="RuleFilter"
                                        Style="{StaticResource SegmentRadioStyle}"
                                        Tag="ip_cidr"
                                        Click="OnRuleFilterClick" />
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1" Padding="8" Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="145" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="95" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox
                                        Margin="0,0,8,0"
                                        SelectedValue="{Binding NewRuleMatchType}"
                                        SelectedValuePath="Content">
                                        <ComboBoxItem Content="process" />
                                        <ComboBoxItem Content="domain" />
                                        <ComboBoxItem Content="ip_cidr" />
                                    </ComboBox>
                                    <TextBox
                                        x:Name="RuleValueTextBox"
                                        Grid.Column="1"
                                        Margin="0,0,8,0"
                                        Padding="9,5"
                                        Text="{Binding NewRuleValue, UpdateSourceTrigger=PropertyChanged}" />
                                    <ComboBox
                                        Grid.Column="2"
                                        Margin="0,0,8,0"
                                        SelectedValue="{Binding NewRuleOutbound}"
                                        SelectedValuePath="Content">
                                        <ComboBoxItem Content="direct" />
                                        <ComboBoxItem Content="aggregation" />
                                        <ComboBoxItem Content="nic_ethernet" />
                                        <ComboBoxItem Content="nic_wifi" />
                                    </ComboBox>
                                    <Button
                                        Grid.Column="3"
                                        Command="{Binding AddRoutingRuleCommand}"
                                        Content="保存"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                                </Grid>
                            </Border>

                            <Border
                                Grid.Row="2"
                                Margin="0,10,0,0"
                                Padding="0"
                                Style="{StaticResource CardStyle}">
                                <DataGrid
                                    x:Name="RoutingRulesGrid"
                                    ItemsSource="{Binding RoutingRules}"
                                    SelectedItem="{Binding SelectedRoutingRule}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn
                                            Width="160"
                                            Binding="{Binding MatchType}"
                                            Header="匹配类型" />
                                        <DataGridTextColumn
                                            Width="*"
                                            Binding="{Binding Value}"
                                            Header="进程 / 域名 / IP" />
                                        <DataGridTextColumn
                                            Width="230"
                                            Binding="{Binding Outbound}"
                                            Header="出口通道" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- 网卡体检 -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="28,28,28,24">
                            <TextBlock Style="{StaticResource PageTitleStyle}" Text="网卡链路体检" />
                            <Button
                                Width="140"
                                Margin="0,24,0,28"
                                HorizontalAlignment="Left"
                                Command="{Binding RunDiagnosticCommand}"
                                Content="开始网卡体检"
                                Style="{StaticResource PrimaryButtonStyle}" />

                            <Grid>
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="网卡链路遥测" />
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <Button
                                        Margin="0,0,8,0"
                                        Command="{Binding SelectAllAdaptersCommand}"
                                        Content="全选"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button
                                        Margin="0,0,8,0"
                                        Command="{Binding ClearAdapterSelectionCommand}"
                                        Content="取消全选"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button
                                        Command="{Binding RescanAdaptersCommand}"
                                        Content="刷新"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                </StackPanel>
                            </Grid>

                            <ItemsControl Margin="0,14,0,24" ItemsSource="{Binding Adapters}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Width="300"
                                            Height="96"
                                            Margin="0,0,16,12"
                                            Style="{StaticResource CardStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="42" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox
                                                    VerticalAlignment="Top"
                                                    IsChecked="{Binding IsSelected}" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Name}" />
                                                    <TextBlock Margin="0,8,0,0" Style="{StaticResource CaptionStyle}" Text="{Binding SourceIp}" />
                                                    <TextBlock Margin="0,5,0,0" Foreground="{StaticResource PrimaryBrush}" Text="{Binding TrafficSummary}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Padding="18" Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="诊断参数" />
                                        <TextBlock Margin="0,14,0,5" Style="{StaticResource CaptionStyle}" Text="源 IP" />
                                        <TextBox Padding="9,6" Text="{Binding DiagnosticSourceIp, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Margin="0,12,0,5" Style="{StaticResource CaptionStyle}" Text="目标 IP" />
                                        <TextBox Padding="9,6" Text="{Binding DiagnosticTargetIp, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Margin="0,12,0,5" Style="{StaticResource CaptionStyle}" Text="探测次数（1–20）" />
                                        <TextBox Width="90" HorizontalAlignment="Left" Padding="9,6" Text="{Binding DiagnosticCount, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock FontWeight="SemiBold" Text="体检结果" />
                                        <TextBlock
                                            Margin="0,14,0,0"
                                            FontFamily="Consolas"
                                            LineHeight="25"
                                            Text="{Binding DiagnosticResult}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Margin="0,14,0,0" Padding="18" Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="150" />
                                    </Grid.RowDefinitions>
                                    <TextBlock FontWeight="SemiBold" Text="运行日志" />
                                    <Button
                                        HorizontalAlignment="Right"
                                        Command="{Binding ClearLogsCommand}"
                                        Content="清空"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                    <ListBox
                                        Grid.Row="1"
                                        BorderThickness="0"
                                        FontFamily="Consolas"
                                        FontSize="12"
                                        ItemsSource="{Binding Logs}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 设置 -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="28,28,28,28">
                            <TextBlock Style="{StaticResource PageTitleStyle}" Text="系统设置" />
                            <TextBlock Margin="0,27,0,12" Style="{StaticResource SectionTitleStyle}" Text="个性化" />

                            <Border Style="{StaticResource SettingRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SmallGlyphStyle}" Text="&#xE790;" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontWeight="SemiBold" Text="界面主题" />
                                        <TextBlock Style="{StaticResource CaptionStyle}" Text="切换浅色、深色，或跟随系统" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Margin="0,0,6,0" Click="OnSystemThemeClick" Content="跟随系统" Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button Margin="0,0,6,0" Click="OnLightThemeClick" Content="浅色" Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button Click="OnDarkThemeClick" Content="深色" Style="{StaticResource SecondaryButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SmallGlyphStyle}" Text="&#xE8B7;" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontWeight="SemiBold" Text="云母窗口材质" />
                                        <TextBlock Style="{StaticResource CaptionStyle}" Text="Windows 11 半透明背景，由系统主题管理" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="已启用" />
                                </Grid>
                            </Border>

                            <TextBlock Margin="0,22,0,12" Style="{StaticResource SectionTitleStyle}" Text="全局设置" />
                            <Border Style="{StaticResource SettingRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SmallGlyphStyle}" Text="&#xE8BB;" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontWeight="SemiBold" Text="关闭行为" />
                                        <TextBlock Style="{StaticResource CaptionStyle}" Text="关闭窗口时保留后台加速，或直接退出程序" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="2" VerticalAlignment="Center" Content="最小化到系统托盘" IsChecked="{Binding CloseToTray}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SmallGlyphStyle}" Text="&#xE839;" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontWeight="SemiBold" Text="本地代理端口" />
                                        <TextBlock Style="{StaticResource CaptionStyle}" Text="应用重启或下次启动加速时生效" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <TextBlock Margin="0,0,7,0" VerticalAlignment="Center" Text="SOCKS5:" />
                                        <TextBox Width="76" Margin="0,0,14,0" Padding="8,5" Text="{Binding SocksPort, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Margin="0,0,7,0" VerticalAlignment="Center" Text="HTTP:" />
                                        <TextBox Width="76" Padding="8,5" Text="{Binding HttpPort, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Margin="0,22,0,12" Style="{StaticResource SectionTitleStyle}" Text="网络与 DNS 设置" />
                            <Border Style="{StaticResource SettingRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SmallGlyphStyle}" Text="&#xE968;" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontWeight="SemiBold" Text="严格路由" />
                                        <TextBlock Style="{StaticResource CaptionStyle}" Text="虚拟网卡模式下阻止流量绕过已选择的出口" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="2" VerticalAlignment="Center" IsChecked="{Binding StrictRoute}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SmallGlyphStyle}" Text="&#xE701;" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontWeight="SemiBold" Text="权重调度" />
                                        <TextBlock Style="{StaticResource CaptionStyle}" Text="按照首页设置的网卡权重分配新连接" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="2" VerticalAlignment="Center" IsChecked="{Binding Weighted}" />
                                </Grid>
                            </Border>

                            <TextBlock Margin="0,22,0,12" Style="{StaticResource SectionTitleStyle}" Text="引擎状态" />
                            <Border Style="{StaticResource SettingRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SmallGlyphStyle}" Text="&#xE774;" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding ConnectionState}" />
                                        <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding HealthSummary}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Margin="0,0,8,0" Command="{Binding ReconnectCommand}" Content="重新连接" Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button Command="{Binding RefreshCommand}" Content="刷新状态" Style="{StaticResource SecondaryButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 关于 -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24,26,28,28">
                            <TextBlock Style="{StaticResource PageTitleStyle}" Text="关于" />
                            <Grid Margin="0,18,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Border MinHeight="245" Style="{StaticResource CardStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe Fluent Icons" FontSize="30" Text="&#xE8A5;" />
                                            <TextBlock Margin="12,4,0,0" FontSize="22" FontWeight="Bold" Text="HypoMux" />
                                        </StackPanel>
                                        <Grid Grid.Row="1" Margin="0,32,0,0">
                                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold">
                                                <Run Text="当前版本: " />
                                                <Run Text="{Binding EngineVersion, Mode=OneWay}" />
                                            </TextBlock>
                                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                <Button Margin="0,0,8,0" Click="OnOpenGitHubClick" Content="GitHub" Style="{StaticResource SecondaryButtonStyle}" />
                                                <Button Click="OnOpenReleasesClick" Content="检查更新" Style="{StaticResource PrimaryButtonStyle}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock
                                            Grid.Row="2"
                                            Margin="0,34,0,0"
                                            VerticalAlignment="Bottom"
                                            LineHeight="21"
                                            Text="HypoMux 是一款面向 Windows 的开源多网卡、双协议分流与聚合工具。"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                                <Border Grid.Column="2" MinHeight="245" Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock FontSize="20" FontWeight="Bold" Text="网络与合规声明" />
                                        <TextBlock
                                            Margin="0,11,0,0"
                                            LineHeight="21"
                                            Text="HypoMux 是一个透明、开源的网络工具，仅用于用户本人拥有授权的设备与网络连接，不应用于绕过第三方访问控制、网络限制或任何未经授权的安全措施。"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Margin="0,14,0,0"
                                            LineHeight="21"
                                            Text="程序停止或卸载时会恢复由其接管的系统代理设置。对于延迟敏感应用，请确认相关进程已配置在合适的分流规则中。"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Margin="0,0,0,14" Padding="22,17" Style="{StaticResource CardStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="30"
                                        FontWeight="Bold"
                                        Foreground="#00A7D8"
                                        Text="SignPath" />
                                    <StackPanel Margin="28,0,0,0">
                                        <TextBlock FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Text="代码签名支持" />
                                        <TextBlock Margin="0,4,0,0" Text="Windows 代码签名由 SignPath.io 免费提供，证书由 SignPath Foundation 颁发。" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Padding="22" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock FontSize="19" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Text="赞助项目" />
                                    <TextBlock
                                        Margin="0,10,0,0"
                                        LineHeight="22"
                                        Text="HypoMux 是一个由技术热情、业余时间独立开发与维护的开源项目。核心功能可永久免费使用；如果它确实帮到了你，欢迎通过项目主页参与贡献或赞助开发。"
                                        TextWrapping="Wrap" />
                                    <TextBlock Margin="0,12,0,0" Foreground="{StaticResource MutedTextBrush}">
                                        <Run Text="平台：" />
                                        <Run Text="{Binding Platform, Mode=OneWay}" />
                                        <Run Text="  ·  权限：" />
                                        <Run Text="{Binding Elevation, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</ui:FluentWindow>
